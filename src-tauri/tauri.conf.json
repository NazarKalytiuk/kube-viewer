{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KubeViewer",
  "identifier": "dev.kubeviewer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KubeViewer",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Fast Kubernetes cluster viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNjM0QUE2MzA1NzFDNDcKUldSSEhGY3dwa3BqanhvejNlUGRPL2tMdWtiZ2h6WFREZEtrUVlMc1UvMkViZzMwSGV0WXZDVVcK",
      "endpoints": [
        "https://github.com/NazarKalytiuk/kube-viewer/releases/latest/download/latest.json"
      ]
    }
  }
}
